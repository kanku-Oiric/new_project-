# ─────────────────────────────────────────────────────────────────────────────
# Salin file ini menjadi .env lalu sesuaikan.
#   copy .env.example .env      (Windows)
# ─────────────────────────────────────────────────────────────────────────────

# Path relatif terhadap folder prisma/, jadi file DB berada di <root>/data/pos.db
DATABASE_URL="file:../data/pos.db"

# Zona waktu untuk penentuan hari usaha (businessDate). Jangan diubah kecuali
# toko benar-benar berada di zona lain — mengubahnya mempengaruhi pengelompokan
# seluruh laporan.
TIMEZONE="Asia/Jakarta"

# ── Backup ───────────────────────────────────────────────────────────────────
# Jumlah salinan backup yang disimpan di folder backups/
BACKUP_KEEP=30

# Opsional: folder tambahan untuk menyalin backup terbaru (USB / folder cloud
# yang tersinkron). Backup di disk yang sama TIDAK melindungi dari disk rusak
# atau laptop hilang. Contoh: BACKUP_MIRROR_DIR="E:/backup-toko"
BACKUP_MIRROR_DIR=

# ── Gemini (opsional, default MATI) ──────────────────────────────────────────
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

# ── Catatan ──────────────────────────────────────────────────────────────────
# Webhook Discord dan token Telegram TIDAK diatur di sini — keduanya diisi lewat
# halaman Pengaturan di aplikasi, supaya pemilik tidak perlu menyentuh file.
