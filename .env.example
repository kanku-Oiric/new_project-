# ─────────────────────────────────────────────────────────────────────────────
# Salin file ini menjadi .env lalu sesuaikan.
#   copy .env.example .env      (Windows)
# ─────────────────────────────────────────────────────────────────────────────

# Path relatif terhadap folder prisma/, jadi file DB berada di <root>/data/pos.db
#
# connection_limit=1 WAJIB, jangan dihapus. SQLite hanya mengizinkan satu
# penulis, dan dengan pool default Prisma beberapa checkout bersamaan saling
# rebutan lock lalu GAGAL SEMUANYA (diukur: 8 checkout bersamaan = 8 transaksi
# gagal). Dengan satu koneksi, checkout mengantre rapi dan selesai < 30ms.
DATABASE_URL="file:../data/pos.db?connection_limit=1"

# Zona waktu untuk penentuan hari usaha (businessDate). Jangan diubah kecuali
# toko benar-benar berada di zona lain — mengubahnya mempengaruhi pengelompokan
# seluruh laporan.
TIMEZONE="Asia/Jakarta"

# ── Backup ───────────────────────────────────────────────────────────────────
# Jumlah salinan backup yang disimpan di folder backups/
BACKUP_KEEP=30

# Opsional: folder tambahan untuk menyalin backup terbaru.
#
# SANGAT disarankan diisi. Backup di disk yang sama TIDAK melindungi dari disk
# rusak, laptop hilang, laptop dicuri, atau ransomware — ketiga salinan ikut
# hilang bersama laptopnya.
#
# Cara termudah bagi toko: pasang Google Drive Desktop, lalu arahkan ke folder
# yang ia buat. Backup akan tersalin ke Drive sendiri, tanpa perlu ingat apa pun.
#
#   BACKUP_MIRROR_DIR="G:/My Drive/Backup Toko"
#
# Kalau nama drive-nya berbeda, buka File Explorer dan lihat huruf drive Google
# Drive di sana. Tanda kutip WAJIB kalau path-nya memuat spasi.
#
# Pilihan lain:
#   BACKUP_MIRROR_DIR="E:/backup-toko"                       (flashdisk)
#   BACKUP_MIRROR_DIR="C:/Users/Toko/OneDrive/Backup Toko"   (OneDrive)
#
# Folder yang tidak ada (misal flashdisk sedang dicabut) BUKAN error: backup
# tetap jalan, penyalinannya saja yang dilewati dan dicatat di log.
#
# Hanya backup yang LULUS pemeriksaan yang disalin ke sini. Berkas yang tidak
# bisa dibuka tidak ada gunanya disebarkan.
BACKUP_MIRROR_DIR=

# Opsional: pindahkan folder backup dari <root>/backups ke tempat lain.
# Dipakai oleh test supaya berkas berisi data uji tidak pernah tercampur dengan
# backup toko yang sungguhan. Biarkan kosong untuk toko.
BACKUP_DIR=

# ── Gambar unggahan ──────────────────────────────────────────────────────────
# Opsional. Folder penyimpanan gambar yang diunggah lewat aplikasi (saat ini:
# gambar QRIS statis). Default: <root>/data/uploads
#
# Gambarnya TIDAK ditaruh di public/ karena folder itu terbuka tanpa login dan
# isinya ikut ke hasil build. Berkas di sini dilayani lewat route yang memeriksa
# session, dan ikut hilang kalau folder data/ tidak diikutkan saat pindah mesin.
UPLOADS_DIR=

# ── Gemini (opsional, default MATI) ──────────────────────────────────────────
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

# ── Catatan ──────────────────────────────────────────────────────────────────
# Webhook Discord dan token Telegram TIDAK diatur di sini — keduanya diisi lewat
# halaman Pengaturan di aplikasi, supaya pemilik tidak perlu menyentuh file.
